{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soundfolk",
  "version": "0.1.0",
  "identifier": "fm.soundfolk.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Soundfolk",
        "width": 480,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "category": "Music",
    "shortDescription": "Discover and listen to web radios from around the world",
    "longDescription": "Soundfolk is a desktop player for internet radio stations: browse and play web radios from around the world, see what is on air, and keep a history of the tracks you heard.",
    "homepage": "https://github.com/raphaelh/soundfolk",
    "license": "MPL-2.0",
    "linux": {
      "deb": {
        "section": "sound",
        "depends": ["libasound2"]
      }
    }
  }
}

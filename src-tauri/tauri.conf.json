{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soundfolk",
  "identifier": "io.github.getsoundfolk.soundfolk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "appDirectoriesOverride": {
      "config": "$CONFIG/soundfolk",
      "data": "$DATA/soundfolk",
      "localData": "$LOCALDATA/soundfolk",
      "cache": "$CACHE/soundfolk"
    },
    "windows": [
      {
        "title": "Soundfolk",
        "create": false,
        "width": 480,
        "height": 720,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' https: http: data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "font-src": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' https: http: data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420",
        "font-src": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["soundfolk"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "category": "Music",
    "shortDescription": "Discover and listen to web radios from around the world",
    "longDescription": "Soundfolk is a desktop player for internet radio stations: browse and play web radios from around the world, see what is on air, and keep a history of the tracks you heard.",
    "homepage": "https://github.com/getsoundfolk/soundfolk",
    "license": "MPL-2.0",
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "section": "sound",
        "depends": ["libasound2"],
        "files": {
          "/usr/share/keyrings/soundfolk-archive-keyring.gpg": "packaging/apt/soundfolk-archive-keyring.gpg",
          "/usr/share/soundfolk/apt/soundfolk.sources": "packaging/apt/soundfolk.sources"
        },
        "postInstallScript": "packaging/apt/postinst.sh",
        "postRemoveScript": "packaging/apt/postrm.sh"
      }
    }
  }
}

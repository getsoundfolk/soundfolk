{
  "name": "soundfolk",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "lint": "eslint . && npm run lint:css && knip && .github/scripts/check-unused-bindings.sh",
    "lint:css": "stylelint \"src/**/*.{css,svelte}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.7.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.5",
    "@tsconfig/svelte": "^5.0.9",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "knip": "^6.48.0",
    "postcss-html": "^2.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "stylelint": "^18.1.0",
    "stylelint-config-recommended": "^19.1.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "license": "MPL-2.0",
  "overrides": {
    "minimatch": "^11.0.4"
  }
